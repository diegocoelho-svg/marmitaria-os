{
  "name": "@marmitaria/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.int.config.ts",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts"
  },
  "dependencies": {
    "@marmitaria/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.5",
    "pg": "8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@marmitaria/config": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
